{
  "name": "reussite-relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var 'ALLOWED_ORIGINS:http://localhost:*,http://127.0.0.1:*'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "bench:push": "esbuild bench/push-tick.ts --bundle --platform=node --format=esm --outfile=bench/.out/push-tick.mjs --log-level=warning && node bench/.out/push-tick.mjs",
    "bench": "esbuild bench/bench.ts --bundle --platform=node --format=esm --outfile=bench/.out/bench.mjs --loader:.md=text --alias:zod=./node_modules/zod --alias:cloudflare:workers=./bench/stub-workers.ts --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --log-level=warning && node bench/.out/bench.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "zod": "4.6.7"
  }
}
