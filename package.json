{
  "name": "reussite",
  "private": true,
  "version": "2.0.0-phase2b",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=firefox",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "check:import": "vitest run --config vitest.private.config.ts --reporter=verbose --silent=false",
    "manual:shots": "sh scripts/manual-shots.sh",
    "e2e:webkit": "sh scripts/e2e-webkit.sh",
    "check:app": "playwright test --config playwright.private.config.ts",
    "e2e:android": "playwright test --project=android",
    "relay:dev": "npm --prefix relay run dev",
    "relay:migrate": "npm --prefix relay run migrate:local",
    "relay:test": "npm --prefix relay test",
    "relay:typecheck": "npm --prefix relay run typecheck",
    "relay:bench": "npm --prefix relay run bench",
    "relay:bench:push": "npm --prefix relay run bench:push"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "dexie": "^4.4.6",
    "jsqr": "1.4.0",
    "preact": "^10.29.8",
    "qrcode-generator": "2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
