# Copy to .dev.vars (gitignored) for `npm run dev`. Never commit real values.
# 32 random bytes, base64:  openssl rand -base64 32
CONNECTOR_WRAP_KEY=
RELAY_URL=http://localhost:8787
# Web Push (docs/dev/push.md): `node scripts/vapid-keygen.mjs` prints both lines; put them here, keep the private one out of the repo.
# VAPID_PUBLIC_KEY is also a var in wrangler.jsonc (a placeholder there); a value here overrides it for `npm run dev`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
