// The relay: one Worker plus D1 (brief §3). Sync and the connector (/mcp, OAuth) are built; push
// and the calendar feed arrive in this same Worker. Local dev and tests only need this file as is.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker created on 19 Oct; the first deploy replaced its placeholder.
  "name": "d1-reussite",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_als: the MCP handler passes the signed-in space to tools with AsyncLocalStorage.
  "compatibility_flags": ["nodejs_als"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prod-d1",
      "database_id": "eac5b14c-f7a1-4ea9-9c0f-3ae01cb73bf8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Connector sign-ins: clients, grants and tokens (the OAuth library's storage).
      "binding": "OAUTH_KV",
      "id": "ef4eab1767b3429a8c8d5e4bf42f365b"
    }
  ],
  // The method and the change-set contract are imported as text, so `get_method` ships them with the Worker.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // One copy of zod in the bundle: the app's source under ../src would otherwise pull in its own.
  "alias": { "zod": "./node_modules/zod" },
  "vars": {
    // Comma-separated. `*` stands for one DNS label or one port. `npm run dev` adds localhost.
    // The app in production, and its preview URLs (`<branch or version>-reussite.…`).
    "ALLOWED_ORIGINS": "https://reussite.rudolphem.workers.dev,https://*-reussite.rudolphem.workers.dev",
    // The relay's public address, no trailing slash: the connector's OAuth issuer and `/mcp` URL.
    "RELAY_URL": "https://d1-reussite.rudolphem.workers.dev",
    // Web Push (docs/dev/push.md). The public key pairs with the secret VAPID_PRIVATE_KEY and is also the app's
    // VITE_VAPID_PUBLIC_KEY (.env.production). The pair was made with scripts/vapid-keygen.mjs.
    "VAPID_PUBLIC_KEY": "BLLTssPj46tNFuuUXJngbmSQb7vLkwXgo3-ma6Oh4aZoH5zaikMHY-qWV3xQZr5rKYWyC0zy0b5sfAEo4iRDY4Y",
    // The relay's own address: the VAPID token's `sub`, so no personal contact reaches a push service.
    "VAPID_SUBJECT": "https://d1-reussite.rudolphem.workers.dev",
    // The hosts a push endpoint may have (blocks the relay being aimed elsewhere): Firefox, Chrome/Android, Safari/iOS, Edge.
    "PUSH_HOSTS": "updates.push.services.mozilla.com,fcm.googleapis.com,*.push.apple.com,*.notify.windows.com"
  },
  // Free plan: 5 cron triggers. Every minute: send due notifications; at minute 0 also prune.
  "triggers": { "crons": ["* * * * *"] }
  // Secrets, set with `wrangler secret put` (never in this file). Locally: relay/.dev.vars (see .dev.vars.example).
  //   CONNECTOR_WRAP_KEY  base64 of 32 random bytes; wraps the space keys the connector holds.
  //   VAPID_PRIVATE_KEY   the private half of the VAPID pair (base64url, 32 bytes), from scripts/vapid-keygen.mjs.
}
